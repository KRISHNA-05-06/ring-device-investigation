{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CheckFixedHouseholdReplayObjects",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::ring-device-investigation-455646290306-us-east-1",
      "Condition": {
        "StringLike": {
          "s3:prefix": "raw/replays/household-001/*"
        }
      }
    },
    {
      "Sid": "ReadReplayEvidence",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::ring-device-investigation-455646290306-us-east-1/raw/replays/household-001/*"
    },
    {
      "Sid": "CreateReplayWithoutOverwriting",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::ring-device-investigation-455646290306-us-east-1/raw/replays/household-001/*",
      "Condition": {
        "StringEquals": {
          "s3:if-none-match": "*"
        }
      }
    }
  ]
}
