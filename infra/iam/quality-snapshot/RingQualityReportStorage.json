{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IdentifyMissingReportObjects",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::ring-device-investigation-455646290306-us-east-1"
    },
    {
      "Sid": "ReadSavedHouseholdQualityReports",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::ring-device-investigation-455646290306-us-east-1/reports/data-quality/household-001/*"
    },
    {
      "Sid": "CreateHouseholdQualityReportsConditionally",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::ring-device-investigation-455646290306-us-east-1/reports/data-quality/household-001/*",
      "Condition": {"StringEquals": {"s3:if-none-match": "*"}}
    }
  ]
}
